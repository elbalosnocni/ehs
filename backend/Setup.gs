function setupEHS(){ Utils.setup(); const sh=Utils.sheet(CONFIG.SHEETS.USER); const users=Utils.getSheetData(CONFIG.SHEETS.USER); if(!users.length){const salt=Utils.randomToken().slice(0,16);Utils.appendObject(CONFIG.SHEETS.USER,{UserID:'U001',Username:'admin',PasswordHash:Utils.hash('Admin@123'+salt),PasswordSalt:salt,Password:'',Role:CONFIG.ROLES.ADMIN,Email:'',Status:'Active',FailedAttempts:0,LockedUntil:'',CreatedDate:new Date(),LastLogin:'',MustChangePassword:true}); Logger.log('Created admin / Admin@123 - change immediately.');} return 'EHS Manager '+CONFIG.VERSION+' setup completed.'; }
