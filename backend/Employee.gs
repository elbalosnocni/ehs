const Employee = {
  getAll:function(payload){ const s=Utils.requireAuth(payload.token); return Utils.ok({data:Utils.safeRows(Utils.getSheetData(CONFIG.SHEETS.EMPLOYEE))}); },
  importList:function(payload){ const s=Utils.requireAuth(payload.token,[CONFIG.ROLES.ADMIN,CONFIG.ROLES.HR,CONFIG.ROLES.HSE]); const list=payload.employees||[]; if(!Array.isArray(list)||!list.length)throw new Error('Danh sách nhân viên rỗng.'); const sh=Utils.sheet(CONFIG.SHEETS.EMPLOYEE); const existing=Utils.getSheetData(CONFIG.SHEETS.EMPLOYEE); const map={};existing.forEach(e=>map[String(e.EmpID||e['Mã NV']||'')]=e); let added=0,updated=0; list.forEach(item=>{const id=String(item.EmpID||item['Mã NV']||item['Mã NV ']||'').trim();if(!id)return; const o={EmpID:id,FullName:item.FullName||item['Họ và Tên']||item['Họ tên']||'',Plant:item.Plant||item['Nhà máy']||'',Department:item.Department||item['Bộ phận']||'',Position:item.Position||item['Chức vụ']||'',DOB:item.DOB||item['Ngày sinh']||item['Năm sinh']||'',Gender:item.Gender||item['Giới tính']||'',HireDate:item.HireDate||item['Ngày vào']||'',Status:item.Status||'Active',Phone:item.Phone||item['Điện thoại']||'',Email:item.Email||'',UpdatedDate:new Date()}; if(map[id]){Utils.updateObject(CONFIG.SHEETS.EMPLOYEE,id,'EmpID',o);updated++;}else{Utils.appendObject(CONFIG.SHEETS.EMPLOYEE,o);added++;}}); Utils.writeAudit(s,'IMPORT','EMPLOYEE','',null,{added,updated},'SUCCESS',''); return Utils.ok({added:added,updated:updated},`Đã thêm ${added}, cập nhật ${updated} nhân viên.`); }
};
