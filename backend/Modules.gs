/**
 * Generic, audited CRUD for EHS operational modules.
 * Multi scope is enforced on reads/writes when user has Plant/Department assignments.
 */
const EHSModule = {
  defs: {
    nearMiss:{sheet:'NEAR_MISS',id:'NearMissID',prefix:'NM',roles:['Administrator','HSE','Manager'],fields:['EventDate','Plant','Department','Location','Description','PotentialSeverity','ImmediateAction','ReportedBy','AssignedTo','Status','IncidentID']},
    unsafeAct:{sheet:'UNSAFE_ACT',id:'UnsafeActID',prefix:'UA',roles:['Administrator','HSE','Manager'],fields:['EventDate','Plant','Department','Location','Description','RiskLevel','PersonInvolved','ImmediateAction','AssignedTo','DueDate','Status']},
    unsafeCondition:{sheet:'UNSAFE_CONDITION',id:'UnsafeConditionID',prefix:'UC',roles:['Administrator','HSE','Manager'],fields:['EventDate','Plant','Department','Location','Description','RiskLevel','ImmediateAction','AssignedTo','DueDate','Status']},
    inspection:{sheet:'INSPECTION',id:'InspectionID',prefix:'INSP',roles:['Administrator','HSE','Manager'],fields:['InspectionDate','Plant','Department','Area','Checklist','Finding','RiskLevel','Assignee','DueDate','Status','VerifiedBy','VerifiedDate']},
    training:{sheet:'TRAINING',id:'TrainingID',prefix:'TRN',roles:['Administrator','HR','HSE','Manager'],fields:['TrainingDate','Plant','Department','Topic','Trainer','AttendeeCount','DurationHours','ValidityUntil','EvidenceUrl','Status']},
    ppe:{sheet:'PPE',id:'PPEID',prefix:'PPE',roles:['Administrator','HR','HSE','Manager'],fields:['EmpID','FullName','Plant','Department','PPEType','Size','IssueDate','ExpiryDate','Quantity','Condition','Status','IssuedBy']},
    riskAssessment:{sheet:'RISK_ASSESSMENT',id:'RiskID',prefix:'RISK',roles:['Administrator','HSE','Manager'],fields:['AssessmentDate','Plant','Department','Area','Activity','Hazard','Consequence','Likelihood','Severity','RiskScore','ControlMeasures','ResidualRisk','Owner','ReviewDate','Status']}
  },
  def:function(key){const d=this.defs[String(key||'')];if(!d)throw new Error('Module không hợp lệ.');return d;},
  scoped:function(rows,user,p){let a=rows.filter(r=>String(r.Status||'')!=='Archived');if(user.plant)a=a.filter(r=>String(r.Plant||'')===String(user.plant));if(user.department)a=a.filter(r=>String(r.Department||'')===String(user.department));if(p.plant)a=a.filter(r=>String(r.Plant)===String(p.plant));if(p.department)a=a.filter(r=>String(r.Department)===String(p.department));if(p.year){const dkey=a.length?(a[0].EventDate!==undefined?'EventDate':a[0].InspectionDate!==undefined?'InspectionDate':a[0].TrainingDate!==undefined?'TrainingDate':'AssessmentDate'):'';if(dkey)a=a.filter(r=>{const dt=new Date(r[dkey]);return !isNaN(dt)&&dt.getFullYear()===Number(p.year);});}if(p.search){const q=String(p.search).toLowerCase();a=a.filter(r=>Object.values(r).join(' ').toLowerCase().includes(q));}return a;},
  get:function(p){const u=Utils.requireAuth(p.token);const d=this.def(p.module);let rows=this.scoped(Utils.getSheetData(CONFIG.SHEETS[d.sheet]),u,p);rows.sort((a,b)=>new Date(b.UpdatedDate||b.CreatedDate||b.EventDate||b.InspectionDate||0)-new Date(a.UpdatedDate||a.CreatedDate||a.EventDate||a.InspectionDate||0));return Utils.ok(Utils.pageRows(rows,p));},
  save:function(p){const u=Utils.requireAuth(p.token);const d=this.def(p.module);if(d.roles.indexOf(u.role)<0)throw new Error('FORBIDDEN');const x=p.data||{};const id=String(x[d.id]||p.recordId||'');const now=new Date();Utils.assertScope(x,u);const o={};d.fields.forEach(k=>{if(x[k]!==undefined)o[k]=x[k];});if(!o.Status)o.Status='Open';o.UpdatedBy=u.userId;o.UpdatedDate=now;if(id){const old=Utils.getSheetData(CONFIG.SHEETS[d.sheet]).find(r=>String(r[d.id])===id);if(!old)throw new Error('Không tìm thấy hồ sơ.');const r=Utils.updateObject(CONFIG.SHEETS[d.sheet],id,d.id,o);Utils.writeAudit(u,'UPDATE',d.sheet,id,r.old,r.new,'SUCCESS','');}else{o[d.id]=Utils.generateId(d.prefix,CONFIG.SHEETS[d.sheet],d.id);o.CreatedBy=u.userId;o.CreatedDate=now;Utils.appendObject(CONFIG.SHEETS[d.sheet],o);Utils.writeAudit(u,'CREATE',d.sheet,o[d.id],null,o,'SUCCESS','');}return Utils.ok({recordId:o[d.id]||id},'Đã lưu hồ sơ.');},
  archive:function(p){const u=Utils.requireAuth(p.token,[CONFIG.ROLES.ADMIN,CONFIG.ROLES.HSE]);const d=this.def(p.module);const id=String(p.recordId||'');const existing=Utils.getSheetData(CONFIG.SHEETS[d.sheet]).find(x=>String(x[d.id])===id);if(!existing)throw new Error('Không tìm thấy hồ sơ.');Utils.assertScope(existing,u);const r=Utils.updateObject(CONFIG.SHEETS[d.sheet],id,d.id,{Status:'Archived',UpdatedBy:u.userId,UpdatedDate:new Date()});Utils.writeAudit(u,'ARCHIVE',d.sheet,id,r.old,r.new,'SUCCESS','Soft archive; dữ liệu được giữ nguyên.');return Utils.ok({},'Đã lưu trữ hồ sơ, không xóa dữ liệu.');}
};
