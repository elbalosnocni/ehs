const Dashboard = {
  getStats:function(payload){ const s=Utils.requireAuth(payload.token); const year=Number(payload.year||new Date().getFullYear()); const accidents=Utils.getSheetData(CONFIG.SHEETS.ACCIDENT); const employees=Utils.getSheetData(CONFIG.SHEETS.EMPLOYEE); const capa=Utils.getSheetData(CONFIG.SHEETS.CAPA); const inv=Utils.getSheetData(CONFIG.SHEETS.INVESTIGATION); const bhxh=Utils.getSheetData(CONFIG.SHEETS.BHXH); const filtered=accidents.filter(a=>{const d=new Date(a.IncidentDate);return !isNaN(d)&&d.getFullYear()===year;}); const activeEmp=employees.filter(e=>String(e.Status||'Active').toLowerCase()!=='inactive').length; let lostDays=0; bhxh.forEach(x=>lostDays+=Number(x.TotalDaysOff||0)); filtered.forEach(x=>lostDays+=Number(x.LostDays||0)); const hours=Math.max(activeEmp,0)*8*22*12; const recordable=filtered.filter(x=>['Medical Treatment','Lost Time','Serious','Nghiêm trọng','Rất nghiêm trọng','Fatal'].some(v=>String(x.Classification||x.IncidentType||x.Severity).includes(v))).length; const monthly=Array(12).fill(0); const dept={},cause={},severity={}; filtered.forEach(a=>{const d=new Date(a.IncidentDate);if(!isNaN(d))monthly[d.getMonth()]++;const k=a.Department||'Khác';dept[k]=(dept[k]||0)+1;const c=a.ImmediateCause||a.InjuryFactor||'Chưa phân loại';cause[c]=(cause[c]||0)+1;const sv=a.Severity||'Chưa phân loại';severity[sv]=(severity[sv]||0)+1;}); const overdue=capa.filter(c=>c.DueDate&&String(c.Status)!=='Đã đóng'&&new Date(c.DueDate)<new Date()).length; const openCapa=capa.filter(c=>String(c.Status)!=='Đã đóng').length; const openInv=inv.filter(i=>String(i.Status)!=='Đã phê duyệt').length; return Utils.ok({year:year,kpi:{employee:activeEmp,accident:filtered.length,recordable:recordable,lostDays:lostDays,workingHours:hours,FR:hours?(filtered.length*1000000/hours).toFixed(2):'0.00',TRIR:hours?(recordable*200000/hours).toFixed(2):'0.00',SR:hours?(lostDays*1000000/hours).toFixed(2):'0.00',openCapa:openCapa,overdueCapa:overdue,openInvestigation:openInv},charts:{monthly:monthly,department:Dashboard.map(dept),cause:Dashboard.map(cause),severity:Dashboard.map(severity)}}); },
  map:function(o){return {labels:Object.keys(o),data:Object.values(o)};}
};
