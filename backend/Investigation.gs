const Investigation = {
  getAll:function(payload){ const s=Utils.requireAuth(payload.token); const inv=Utils.safeRows(Utils.getSheetData(CONFIG.SHEETS.INVESTIGATION)); const capa=Utils.safeRows(Utils.getSheetData(CONFIG.SHEETS.CAPA)); return Utils.ok({investigations:inv,capa:capa}); },
  getOne:function(payload){ const s=Utils.requireAuth(payload.token); const id=String(payload.investigationId||''); const inv=Utils.getSheetData(CONFIG.SHEETS.INVESTIGATION).find(x=>String(x.InvestigationID)===id); if(!inv)throw new Error('Không tìm thấy điều tra.'); return Utils.ok({data:Utils.safeRows([inv])[0],fiveWhy:Utils.safeRows(Utils.getSheetData(CONFIG.SHEETS.FIVE_WHY).filter(x=>String(x.InvestigationID)===id)),evidence:Utils.safeRows(Utils.getSheetData(CONFIG.SHEETS.INVESTIGATION_EVIDENCE).filter(x=>String(x.InvestigationID)===id)),capa:Utils.safeRows(Utils.getSheetData(CONFIG.SHEETS.CAPA).filter(x=>String(x.InvestigationID)===id))}); },
  save:function(payload){ const s=Utils.requireAuth(payload.token,[CONFIG.ROLES.ADMIN,CONFIG.ROLES.HSE,CONFIG.ROLES.MANAGER]); const p=payload.data||payload; let id=p.investigationId||p.InvestigationID; const now=new Date(); const o={InvestigationID:id||Utils.generateId('INV',CONFIG.SHEETS.INVESTIGATION,'InvestigationID'),AccidentID:p.accidentId||p.AccidentID||'',Lead:p.lead||p.Lead||s.userId,InvestigationDate:p.investigationDate||now,Method:p.method||'5 Why',ImmediateCause:p.immediateCause||'',BasicCause:p.basicCause||'',RootCause:p.rootCause||'',FiveWhySummary:p.fiveWhySummary||'',FishboneSummary:p.fishboneSummary||'',Conclusion:p.conclusion||'',Status:p.status||'Đang điều tra',ApprovedBy:p.approvedBy||'',ApprovedDate:p.approvedDate||'',CreatedBy:p.createdBy||s.userId,CreatedDate:p.createdDate||now,UpdatedBy:s.userId,UpdatedDate:now}; if(id){const r=Utils.updateObject(CONFIG.SHEETS.INVESTIGATION,id,'InvestigationID',o); Utils.writeAudit(s,'UPDATE','INVESTIGATION',id,r.old,r.new,'SUCCESS','');}else{Utils.appendObject(CONFIG.SHEETS.INVESTIGATION,o);id=o.InvestigationID;Utils.writeAudit(s,'CREATE','INVESTIGATION',id,null,o,'SUCCESS','');} if(Array.isArray(p.fiveWhy)){p.fiveWhy.forEach((x,i)=>{if(x.answer||x.question){Utils.appendObject(CONFIG.SHEETS.FIVE_WHY,{FiveWhyID:Utils.generateId('WHY',CONFIG.SHEETS.FIVE_WHY,'FiveWhyID'),InvestigationID:id,AccidentID:o.AccidentID,StepNo:i+1,Question:x.question||('Why '+(i+1)),Answer:x.answer||'',CreatedBy:s.userId,CreatedDate:now});}});} if(p.files&&p.files.length){const saved=Utils.saveFiles(id,'INVESTIGATION',p.files,s); saved.forEach(f=>Utils.appendObject(CONFIG.SHEETS.INVESTIGATION_EVIDENCE,{EvidenceID:Utils.generateId('EVI',CONFIG.SHEETS.INVESTIGATION_EVIDENCE,'EvidenceID'),InvestigationID:id,AccidentID:o.AccidentID,EvidenceType:'FILE',Description:f.Description,FileID:f.FileID,DriveFileId:f.DriveFileId,DriveUrl:f.DriveUrl,CreatedBy:s.userId,CreatedDate:now}));} return Utils.ok({investigationId:id},'Đã lưu điều tra.'); },
  verify:function(payload){ const s=Utils.requireAuth(payload.token,[CONFIG.ROLES.ADMIN,CONFIG.ROLES.HSE,CONFIG.ROLES.MANAGER]); const id=String(payload.investigationId); const r=Utils.updateObject(CONFIG.SHEETS.INVESTIGATION,id,'InvestigationID',{Status:'Đã phê duyệt',ApprovedBy:s.userId,ApprovedDate:new Date(),UpdatedBy:s.userId,UpdatedDate:new Date()}); Utils.writeAudit(s,'APPROVE','INVESTIGATION',id,r.old,r.new,'SUCCESS',''); return Utils.ok({},'Đã phê duyệt điều tra.'); },
  saveCapa:function(payload){ const s=Utils.requireAuth(payload.token,[CONFIG.ROLES.ADMIN,CONFIG.ROLES.HSE,CONFIG.ROLES.MANAGER]); const p=payload.data||payload; let id=p.capaId||p.CapaID; const now=new Date(); if(!id)id=Utils.generateId('CAPA',CONFIG.SHEETS.CAPA,'CapaID'); let progress=Number(p.progress||0); let status=p.status||'Chưa thực hiện'; if(status==='Hoàn thành')progress=100; if(status==='Chưa thực hiện')progress=0; const o={CapaID:id,AccidentID:p.accidentId||p.AccidentID||'',InvestigationID:p.investigationId||p.InvestigationID||'',RootCause:p.rootCause||'',ActionType:p.actionType||'Corrective',Action:p.action||'',Assignee:p.assignee||'',Department:p.department||'',Priority:p.priority||'Trung bình',StartDate:p.startDate||'',DueDate:p.dueDate||'',Progress:progress,Status:status,EvidenceRequired:p.evidenceRequired===undefined?true:p.evidenceRequired,CompletedDate:status==='Hoàn thành'?(p.completedDate||now):'',VerifiedDate:p.verifiedDate||'',Effectiveness:p.effectiveness||'',ClosedDate:p.closedDate||'',CreatedBy:p.createdBy||s.userId,CreatedDate:p.createdDate||now,UpdatedBy:s.userId,UpdatedDate:now}; if(p.evidenceRequired && !p.files?.length && status==='Hoàn thành' && !p.allowNoEvidence)throw new Error('CAPA hoàn thành phải có bằng chứng.'); if(p.verifiedDate && status!=='Hoàn thành')throw new Error('Chỉ xác minh CAPA đã hoàn thành.'); if(payload.close===true && (!p.effectiveness||p.effectiveness===''))throw new Error('Cần đánh giá hiệu lực trước khi đóng CAPA.'); if(payload.close===true)o.Status='Đã đóng'; if(id && Utils.findRowById(CONFIG.SHEETS.CAPA,id,'CapaID')>0){const r=Utils.updateObject(CONFIG.SHEETS.CAPA,id,'CapaID',o);Utils.writeAudit(s,'UPDATE','CAPA',id,r.old,r.new,'SUCCESS','');}else{Utils.appendObject(CONFIG.SHEETS.CAPA,o);Utils.writeAudit(s,'CREATE','CAPA',id,null,o,'SUCCESS','');} if(p.files&&p.files.length){const saved=Utils.saveFiles(id,'CAPA',p.files,s);saved.forEach(f=>Utils.appendObject(CONFIG.SHEETS.CAPA_EVIDENCE,{EvidenceID:Utils.generateId('CEV',CONFIG.SHEETS.CAPA_EVIDENCE,'EvidenceID'),CapaID:id,Description:f.Description,FileID:f.FileID,DriveFileId:f.DriveFileId,DriveUrl:f.DriveUrl,UploadedBy:s.userId,UploadedDate:now}));} return Utils.ok({capaId:id},'Đã lưu CAPA.'); },
  verifyCapa:function(payload){ const s=Utils.requireAuth(payload.token,[CONFIG.ROLES.ADMIN,CONFIG.ROLES.HSE,CONFIG.ROLES.MANAGER]); const id=String(payload.capaId); const c=Utils.getSheetData(CONFIG.SHEETS.CAPA).find(x=>String(x.CapaID)===id); if(!c)throw new Error('Không tìm thấy CAPA.'); if(String(c.Status)!=='Hoàn thành')throw new Error('CAPA phải hoàn thành trước khi xác minh.'); const vid=Utils.generateId('VER',CONFIG.SHEETS.CAPA_VERIFICATION,'VerificationID'); const effective=Utils.parseBool(payload.effective); Utils.appendObject(CONFIG.SHEETS.CAPA_VERIFICATION,{VerificationID:vid,CapaID:id,VerifiedBy:s.userId,VerificationDate:new Date(),Effective:effective,Findings:payload.findings||'',FollowUpDate:payload.followUpDate||'',Status:effective?'Đạt':'Không đạt',CreatedDate:new Date()}); const newStatus=effective?'Đã đóng':'Đang thực hiện'; const r=Utils.updateObject(CONFIG.SHEETS.CAPA,id,'CapaID',{VerifiedDate:new Date(),Effectiveness:effective?'Đạt':'Không đạt',Status:newStatus,ClosedDate:effective?new Date():'',UpdatedBy:s.userId,UpdatedDate:new Date()}); Utils.writeAudit(s,'VERIFY','CAPA',id,r.old,r.new,'SUCCESS',payload.findings||''); return Utils.ok({},effective?'CAPA đã được xác minh và đóng.':'CAPA chưa đạt, cần thực hiện lại.'); }
};
