  verify:function(payload){ const s=Utils.requireAuth(payload.token,[CONFIG.ROLES.ADMIN,CONFIG.ROLES.HSE,CONFIG.ROLES.MANAGER]); const id=String(payload.investigationId);const inv=Utils.getSheetData(CONFIG.SHEETS.INVESTIGATION).find(x=>String(x.InvestigationID)===id);if(!inv)throw new Error('Không tìm thấy điều tra.');const parent=Utils.getSheetData(CONFIG.SHEETS.ACCIDENT).find(a=>String(a.AccidentID)===String(inv.AccidentID));if(parent)Utils.assertScope(parent,s); const r=Utils.updateObject(CONFIG.SHEETS.INVESTIGATION,id,'InvestigationID',{Status:'Đã phê duyệt',ApprovedBy:s.userId,ApprovedDate:new Date(),UpdatedBy:s.userId,UpdatedDate:new Date()}); Utils.writeAudit(s,'APPROVE','INVESTIGATION',id,r.old,r.new,'SUCCESS',''); return Utils.ok({},'Đã phê duyệt điều tra.'); },
  saveCapa:function(payload){ const s=Utils.requireAuth(payload.token,[CONFIG.ROLES.ADMIN,CONFIG.ROLES.HSE,CONFIG.ROLES.MANAGER]); const p=payload.data||payload; let id=p.capaId||p.CapaID; const now=new Date();const linked=Utils.getSheetData(CONFIG.SHEETS.ACCIDENT).find(a=>String(a.AccidentID)===String(p.accidentId||p.AccidentID||''));if(linked)Utils.assertScope(linked,s);else Utils.assertScope({Plant:p.plant||p.Plant,Department:p.department||p.Department},s); if(!id)id=Utils.generateId('CAPA',CONFIG.SHEETS.CAPA,'CapaID'); let progress=Number(p.progress||0); let status=p.status||'Chưa thực hiện'; if(status==='Hoàn thành')progress=100; if(status==='Chưa thực hiện')progress=0; const o={CapaID:id,AccidentID:p.accidentId||p.AccidentID||'',InvestigationID:p.investigationId||p.InvestigationID||'',Plant:p.plant||p.Plant||(linked&&linked.Plant)||'',RootCause:p.rootCause||'',ActionType:p.actionType||'Corrective',Action:p.action||'',Assignee:p.assignee||'',Department:p.department||p.Department||(linked&&linked.Department)||'',Priority:p.priority||'Trung bình',StartDate:p.startDate||'',DueDate:p.dueDate||'',Progress:progress,Status:status,EvidenceRequired:p.evidenceRequired===undefined?true:p.evidenceRequired,CompletedDate:status==='Hoàn thành'?(p.completedDate||now):'',VerifiedDate:p.verifiedDate||'',Effectiveness:p.effectiveness||'',ClosedDate:p.closedDate||'',CreatedBy:p.createdBy||s.userId,CreatedDate:p.createdDate||now,UpdatedBy:s.userId,UpdatedDate:now}; if((p.evidenceRequired===undefined?true:Utils.parseBool(p.evidenceRequired)) && !p.files?.length && status==='Hoàn thành' && !Utils.parseBool(p.allowNoEvidence))throw new Error('CAPA hoàn thành phải có bằng chứng.'); if(p.verifiedDate && status!=='Hoàn thành')throw new Error('Chỉ xác minh CAPA đã hoàn thành.'); if(payload.close===true)throw new Error('Không được đóng CAPA trực tiếp. Hãy hoàn thành và dùng bước xác minh hiệu lực.'); if(id && Utils.findRowById(CONFIG.SHEETS.CAPA,id,'CapaID')>0){const r=Utils.updateObject(C