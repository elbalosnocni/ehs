function createEHSBackup(payload){const u=Utils.requireAuth(payload.token,[CONFIG.ROLES.ADMIN]);const ss=Utils.ss();const folder=Utils.getDriveRoot();const file=DriveApp.getFileById(ss.getId()).makeCopy('EHS_BACKUP_'+Utilities.formatDate(new Date(),CONFIG.TIMEZONE,'yyyyMMdd_HHmmss'),folder);const attachmentFolder=folder.createFolder('EHS_ATTACHMENTS_BACKUP_'+Utilities.formatDate(new Date(),CONFIG.TIMEZONE,'yyyyMMdd_HHmmss'));let copied=0;Utils.getSheetData(CONFIG.SHEETS.ACCIDENT_ATTACHMENT).forEach(a=>{if(a.DriveFileId){try{DriveApp.getFileById(a.DriveFileId).makeCopy(a.FileName||a.DriveFileId,attachmentFolder);copied++;}catch(e){}}});const id=Utils.generateId('BKP',CONFIG.SHEETS.SYSTEM_BACKUP,'BackupID');Utils.appendObject(CONFIG.SHEETS.SYSTEM_BACKUP,{BackupID:id,BackupDate:new Date(),SpreadsheetId:ss.getId(),DriveFileId:file.getId(),DriveUrl:file.getUrl(),Status:'Created',Notes:'Spreadsheet + '+copied+' attachment copies; cần kiểm tra khôi phục định kỳ.'});Utils.writeAudit(u,'BACKUP','SYSTEM',id,null,{DriveFileId:file.getId()},'SUCCESS','');return Utils.ok({backupId:id,url:file.getUrl()},'Đã tạo bản sao lưu Spreadsheet.');}
