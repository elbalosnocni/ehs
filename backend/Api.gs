function doGet(e){ try{const p=(e&&e.parameter)||{}; if(p.action==='health')return Utils.responseJSON({status:'online',version:CONFIG.VERSION,time:new Date().toISOString()}); return Utils.err('API chỉ cho phép GET health. Dữ liệu nghiệp vụ dùng POST có token.','METHOD_NOT_ALLOWED');}catch(err){return Utils.err(err.message||err,'SERVER_ERROR');} }
function doPost(e){ try{Utils.setup(); if(!e||!e.postData||!e.postData.contents)return Utils.err('Request rỗng.','BAD_REQUEST'); const p=JSON.parse(e.postData.contents); const a=p.action; switch(a){case'login':return Auth.login(p);case'logout':return Auth.logout(p);case'me':return Auth.me(p);case'changePassword':return Auth.changePassword(p);case'resetPassword':return Auth.resetPassword(p);case'lockUser':return Auth.setLock(Object.assign({},p,{lock:true}));case'unlockUser':return Auth.setLock(Object.assign({},p,{lock:false}));case'getUsers':return Auth.users(p);case'getAccidents':return Accident.getAll(p);case'getAccident':return Accident.getOne(p);case'createAccident':case'saveAccident':return Accident.create(p);case'updateAccident':return Accident.update(p);case'addTimeline':return Accident.addTimeline(p);case'getInvestigationData':return Investigation.getAll(p);case'getInvestigation':return Investigation.getOne(p);case'saveInvestigation':return Investigation.save(p);case'approveInvestigation':return Investigation.verify(p);case'saveCapa':case'saveCapaRecord':return Investigation.saveCapa(p);case'verifyCapa':return Investigation.verifyCapa(p);case'getDashboard':return Dashboard.getStats(p);case'getEmployees':return Employee.getAll(p);case'importEmployees':return Employee.importList(p);case'getMaster':return getMasterDropdowns(p);default:return Utils.err('Action không hợp lệ: '+a,'BAD_ACTION');}}catch(err){const msg=err&&err.message?err.message:String(err); if(msg==='SESSION_EXPIRED')return Utils.err('Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.','SESSION_EXPIRED');if(msg==='FORBIDDEN')return Utils.err('Bạn không có quyền thực hiện thao tác này.','FORBIDDEN');return Utils.err(msg,'SERVER_ERROR');} }
